# ===================================
# AI Stock Analysis System - Environment Variable Configuration Template
# Copy this file to .env and fill in your actual values
# ===================================

# Watchlist (comma-separated; supports Shanghai/Shenzhen stock codes)
# Shanghai: 600xxx, 601xxx, 603xxx
# Shenzhen: 000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594

# Data source configuration
# Tushare Pro Token (optional, get from https://tushare.pro/weborder/#/login?reg=834638)
TUSHARE_TOKEN=
# TickFlow API Key (optional; enhances A-share market review indexes; also enriches market stats when ticker pool queries are available)
# TICKFLOW_API_KEY=

# ===================================
# Scheduled task configuration (local/Docker)
# ===================================
# SCHEDULE_ENABLED=true
# SCHEDULE_TIME=18:00
# Whether to run once immediately on startup (default: true)
# SCHEDULE_RUN_IMMEDIATELY=false
# Trading day check: default true, skips on non-trading days; set to false or use --force-run to always execute (Issue #373)
# TRADING_DAY_CHECK_ENABLED=true

# ===================================
# AI model configuration
# ===================================
# Full documentation: docs/LLM_CONFIG_GUIDE.md
#
# [Quick Start] Fill in one API Key to get started; the system auto-detects the model.
#   Gemini (free tier) → set GEMINI_API_KEY
#   DeepSeek (cost-effective) → set DEEPSEEK_API_KEY
#   AIHubmix (aggregation platform) → set AIHUBMIX_KEY
#
# [Advanced] For multi-model / multi-platform fallback → configure "Multi-channel" below or manage via the Web settings page.
# ===================================

# --- API Key (fill in at least one) ---

# Gemini（https://aistudio.google.com）
GEMINI_API_KEY=
# Multi-key load balancing: GEMINI_API_KEYS=key1,key2,key3

# DeepSeek（https://platform.deepseek.com）
# DEEPSEEK_API_KEY=

# AIHubmix aggregation (https://aihubmix.com/?aff=CfMq)
# One key for GPT/Claude/Gemini/GLM/Qwen and more; no VPN required
# AIHUBMIX_KEY=

# Anthropic Claude（https://console.anthropic.com）
# ANTHROPIC_API_KEY=

# OpenAI / compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # Third-party API base URL (relay/proxy); leave blank for official

# Ollama local model (no API key needed, recommended)
# OLLAMA_API_BASE=http://localhost:11434
# LITELLM_MODEL=ollama/qwen3:8b
#
# Or use channel mode:
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b

# Sampling temperature (0.0-2.0, default 0.7; 0 = most deterministic, 2 = most random)
# LLM_TEMPERATURE=0.7

# --- Multi-channel configuration (optional, also configurable via Web settings page) ---
# Each channel has independent base_url / api_key / models; supports multi-key round-robin and automatic fallback.
#
# Example: DeepSeek + Gemini dual channel
# LLM_CHANNELS=deepseek,gemini
# LLM_DEEPSEEK_API_KEY=sk-xxx
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_DEEPSEEK_MODELS=deepseek-chat
# LLM_GEMINI_API_KEYS=key1,key2
# LLM_GEMINI_MODELS=gemini-2.5-flash
#
# Example: Custom API endpoint (third-party proxy / aggregation platform / relay)
# LLM_CHANNELS=my_proxy
# LLM_MY_PROXY_BASE_URL=https://your-proxy.example.com/v1
# LLM_MY_PROXY_API_KEY=sk-xxx
# LLM_MY_PROXY_MODELS=gpt-4o-mini,claude-3-5-sonnet
# LLM_MY_PROXY_PROTOCOL=openai
#
# Example: Ollama local model (no API key)
# LLM_CHANNELS=ollama
# LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_OLLAMA_MODELS=qwen3:8b,llama3.2

# Advanced: YAML configuration (optional, standard LiteLLM Router format, see litellm_config.example.yaml)
# LITELLM_CONFIG=./litellm_config.yaml

# ===================================
# Search engine configuration (used to fetch stock news)
# ===================================
# Bocha API Keys (optimized for Chinese search, supports AI summaries; multiple keys comma-separated)
# Get yours at: https://open.bocha.cn/
# BOCHA_API_KEYS=your_bocha_key_here
# MiniMax API Key (Coding Plan Web Search; multiple keys comma-separated)
# Get yours at: https://platform.minimaxi.com/
# MINIMAX_API_KEYS=your_minimax_key_here
# Tavily API Keys (multiple keys comma-separated)
TAVILY_API_KEYS=
# SerpAPI Keys (multiple keys comma-separated)
SERPAPI_API_KEYS=
# Brave Search API Keys (multiple keys comma-separated)
# Get yours at: https://brave.com/search/api/
BRAVE_API_KEYS=
# SearXNG instance URLs (comma-separated; private deployments have no quota; enable `format: json` in settings.yml)
# When empty, public instances are automatically fetched from searx.space; set the flag below to false to disable that
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=true

# ===================================
# Social Sentiment Intelligence (US stocks only)
# ===================================
# Reddit / X (Twitter) / Polymarket sentiment data from api.adanos.org
# Only activates for US stock tickers (AAPL, TSLA, etc.), ignored for A-shares/HK stocks
# Free tier: 250 requests/month | Register: https://api.adanos.org
# SOCIAL_SENTIMENT_API_KEY=sk_live_your_key_here
# SOCIAL_SENTIMENT_API_URL=https://api.adanos.org

# ===================================
# News freshness and analysis filter configuration
# ===================================
# News strategy window: ultra_short(1 day) / short(3 days) / medium(7 days) / long(30 days)
# Effective window = min(strategy window, NEWS_MAX_AGE_DAYS)
# NEWS_STRATEGY_PROFILE=short
# Maximum news age (days); restricts search results to recent content to avoid stale data
# NEWS_MAX_AGE_DAYS=3
# Bias rate threshold (%); alerts when price deviates from MA5 beyond this value; automatically relaxed to 1.5x for strong-trend stocks
# BIAS_THRESHOLD=5.0

# ===================================
# Agent strategy chat configuration (Web chat page)
# ===================================
# Enable Agent strategy chat (default false; internally named 'skill')
# AGENT_MODE=true
# Agent primary model (optional): inherits LITELLM_MODEL when empty; models without a provider prefix are resolved as openai/<model>
# AGENT_LITELLM_MODEL=
# Maximum reasoning steps for Agent
# AGENT_MAX_STEPS=10
# Default active skills (comma-separated); uses built-in defaults when not configured
#
# Built-in strategy skill list (any combination):
#   bull_trend          — Bull trend (MA5>MA10>MA20 alignment + low bias rate)
#   ma_golden_cross     — MA golden cross (MA5 crosses above MA10/MA20)
#   volume_breakout     — Volume breakout (price breaks recent high + increased volume)
#   shrink_pullback     — Shrink pullback (pullback to MA + decreasing volume; buy-the-dip point)
#   bottom_volume       — Bottom volume (minimum volume signals price bottom; reversal signal)
#   dragon_head         — Dragon head (leading strong stocks; momentum continuation)
#   one_yang_three_yin  — One-yang-three-yin (strong engulfing pattern after shakeout)
#   box_oscillation     — Box oscillation (range-bound high-sell/low-buy strategy)
#   chan_theory          — Chan theory (Bi/segment/pivot center analysis)
#   wave_theory         — Wave theory (Elliott Wave counting)
#   emotion_cycle       — Emotion cycle (market sentiment high/low rotation)
#
# When empty, the system uses the primary default skill declared in metadata (built-in default: bull_trend)
# AGENT_SKILLS=
#
# You can also specify a set of strategies manually:
# AGENT_SKILLS=bull_trend,ma_golden_cross,shrink_pullback
#
# Enable all built-in strategies (both forms are equivalent):
# AGENT_SKILLS=all
# AGENT_SKILLS=bull_trend,ma_golden_cross,volume_breakout,shrink_pullback,bottom_volume,dragon_head,one_yang_three_yin,box_oscillation,chan_theory,wave_theory,emotion_cycle
#
AGENT_SKILLS=
# Custom strategy directory (optional; place custom YAML strategy files here; env var names follow internal skill naming)
# AGENT_SKILL_DIR=./strategies

# Agent architecture mode (default: single; multi enables multi-agent orchestration)
# AGENT_ARCH=single

# Multi-Agent orchestration mode (only active when AGENT_ARCH=multi)
# quick: technicals→decision (fastest, ~2 LLM calls)
# standard: technicals→intelligence→decision (default)
# full: technicals→intelligence→risk→decision
# specialist: technicals→intelligence→risk→strategy expert evaluation→decision
# AGENT_ORCHESTRATOR_MODE=standard

# Agent execution timeout budget (seconds, 0 = disabled; for single-agent it is the overall loop budget; for multi-agent it is the orchestration budget; default 600)
# AGENT_ORCHESTRATOR_TIMEOUT_S=600

# Whether the risk-control Agent can veto buy signals (default: enabled)
# AGENT_RISK_OVERRIDE=true

# Memory and calibration system (tracks historical accuracy and auto-adjusts confidence)
# AGENT_MEMORY_ENABLED=false

# Automatically weight strategy opinions by backtest performance
# AGENT_SKILL_AUTOWEIGHT=true

# Strategy routing mode (auto = auto-select based on market state / manual = use AGENT_SKILLS list)
# AGENT_SKILL_ROUTING=auto

# ===================================
# Notification channel configuration (multiple channels can be configured simultaneously)
# ===================================
#
# [Option 1] WeChat Work bot
# In a WeChat Work group → Settings → Group Bots → Add → Copy the Webhook URL
#
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key_here
#
# [Option 2] Feishu (Lark) bot
# In a Feishu group → Settings → Group Bots → Add bot → Custom bot → Copy the Webhook URL
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_key_here
#
# [Option 3] Telegram bot (both items must be configured)
# 1. In Telegram, message @BotFather → /newbot → obtain Bot Token
# 2. Get Chat ID: send a message to @userinfobot or visit https://api.telegram.org/bot<token>/getUpdates
#
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_MESSAGE_THREAD_ID=2780
#
# [Option 4] Email push (only 2 settings required; SMTP auto-detected)
# Supports QQ Mail, 163 Mail, Gmail and any SMTP authorization-code/basic-auth mailbox
# Outlook / Exchange with tenant-enforced OAuth2 is not supported in the current version
# 1. Get authorization code (e.g. QQ Mail): Settings → Account → POP3/SMTP service → Enable → Get authorization code
# 2. Fill in the two fields below:
#
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=receiver@example.com  # Optional; leave empty to send to yourself
#
# [Option 4 extension] Send stock groups to different mailboxes (Issue #268, optional)
# When configured, reports for different stock groups are sent to the corresponding mailbox; market review is sent to all configured mailboxes
# STOCK_GROUP_1=600519,300750
# EMAIL_GROUP_1=user1@example.com
# STOCK_GROUP_2=002594,AAPL
# EMAIL_GROUP_2=user2@example.com
#
# [Option 5] Custom Webhook (supports multiple, comma-separated)
# Suitable for: DingTalk, Discord, Slack, Bark, custom services, and any Webhook that accepts POST JSON
# The system auto-detects common services and uses the appropriate format
#
# CUSTOM_WEBHOOK_URLS=https://oapi.dingtalk.com/robot/send?access_token=xxx,https://hooks.slack.com/services/xxx
# CUSTOM_WEBHOOK_BEARER_TOKEN=  # Optional; used for Webhooks that require authentication (Header: Authorization: Bearer <token>)
# WEBHOOK_VERIFY_SSL=true   # Default: verify SSL. Set to false to allow self-signed certificates. Warning: disabling creates MITM risk; use only in trusted internal networks
#
# [Option 6] Pushover configuration
# Register a Pushover account and create an application token at https://pushover.net/apps/build
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=
#
# [Option 7] PushPlus configuration (domestic Chinese push service, recommended)
# Register a PushPlus account and get your token at https://www.pushplus.plus
# PUSHPLUS_TOKEN=
# Group push: fill in the group code to push messages to all group subscribers (one-to-many)
# PUSHPLUS_TOPIC=
#
# [Option 8] Discord configuration
# Supports two methods: Webhook (recommended, simple setup) and Bot API (more permissions)
# 
# Method 1: Discord Webhook (recommended, no Bot account needed)
# In Discord channel settings → Integrations → Webhooks → New Webhook → Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# 
# Method 2: Discord Bot API (requires a Bot account and channel ID)
# 1. Create a Bot: https://discord.com/developers/applications → New Application → Bot → Create Bot
# 2. Get Bot Token: Bot page → Reset Token
# 3. Get channel ID: Enable Developer Mode in Discord → Right-click the channel → Copy ID
# DISCORD_BOT_TOKEN=
# DISCORD_MAIN_CHANNEL_ID=
# DISCORD_CHANNEL_ID=   # Legacy variable name; prefer DISCORD_MAIN_CHANNEL_ID
# 
# [Option 9] Slack configuration
# Supports two methods: Bot API (recommended) and Incoming Webhook
# When both are configured, Bot API takes priority to ensure text and images go to the same channel.
#
# Method 1: Slack Bot API (recommended, supports image upload)
# 1. Create a Slack App: https://api.slack.com/apps → Create New App
# 2. Add Bot Token Scopes: chat:write, files:write
# 3. Install to workspace and get Bot Token (xoxb-...)
# 4. Get channel ID: Channel details → Copy channel ID at the bottom
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C01234567
#
# Method 2: Slack Incoming Webhook (simple setup, no image upload support)
# In the Slack App management page, create an Incoming Webhook → Copy URL
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
#
# [Option 10] Server Chan 3 configuration (domestic Chinese push service, supports WeChat push)
# Register a Server Chan 3 account and get your SendKey at https://sc3.ft07.com/
# SERVERCHAN3_SENDKEY=
#
# [Advanced] Message length limits (bytes)
# Messages exceeding the limit are automatically split into batches; usually no changes needed
# FEISHU_MAX_BYTES=20000    # Feishu limit ~20 KB, default 20000 bytes
# WECHAT_MAX_BYTES=4000     # WeChat Work limit 4096 bytes, default 4000 bytes
#
# [Markdown to Image] (Issue #455)
# For channels that do not support Markdown, converts the report to an image for better readability
# Single-stock push + image: requires MARKDOWN_TO_IMAGE_CHANNELS to be set and the conversion tool to be installed
# MARKDOWN_TO_IMAGE_CHANNELS=telegram,wechat,custom,email,slack   # comma-separated
# MARKDOWN_TO_IMAGE_MAX_CHARS=15000   # Content exceeding this length is not converted to avoid oversized images
# MD2IMG_ENGINE=wkhtmltoimage   # wkhtmltoimage (default) | markdown-to-file (better emoji support, requires npm i -g markdown-to-file)
# Conversion tool: wkhtmltopdf (apt install wkhtmltopdf / brew install wkhtmltopdf) or markdown-to-file
#
# [Real-time quote prefetch] (Issue #455)
# PREFETCH_REALTIME_QUOTES=true   # Set to false to disable and avoid full-market pulls from efinance/akshare_em; tushare uses a single-stock interface so prefetch only fetches the first stock

# ===================================
# Single-stock notification configuration (optional)
# ===================================
# Single-stock push mode: push immediately after each stock is analyzed instead of waiting for the batch summary
# SINGLE_STOCK_NOTIFY=false
#
# Report type: simple (concise), full (complete), brief (3-5 sentence summary)
# In Docker environments where the push content is incomplete, set this to full
# REPORT_TYPE=simple
# Report output language: zh (Chinese, default) / en (English)
# REPORT_LANGUAGE=zh
# Analysis summary only: set to true to push only the summary without individual stock details
# REPORT_SUMMARY_ONLY=false
#
# Report Engine P0 (Jinja2 / integrity validation / historical comparison)
# REPORT_TEMPLATES_DIR=templates
# REPORT_RENDERER_ENABLED=false
# REPORT_INTEGRITY_ENABLED=true
# REPORT_INTEGRITY_RETRY=1
# REPORT_HISTORY_COMPARE_N=0

# Merge individual stock analysis and market review into a single push (default false); reduces email count and spam risk
# MERGE_EMAIL_NOTIFICATION=false

# ===================================
# Analysis interval configuration (optional)
# ===================================
# Delay (seconds) between individual stock analysis and market review
# Prevents rate limiting from Gemini and other AI APIs
# ANALYSIS_DELAY=0

# App AppKey (shared with Webhook mode)
DINGTALK_APP_KEY=xxxx
# App AppSecret (shared with Webhook mode)
DINGTALK_APP_SECRET=xxxx
# Enable Stream mode
DINGTALK_STREAM_ENABLED=false

# Feishu (Lark) app bot configuration
FEISHU_APP_ID=xxxx
FEISHU_APP_SECRET=xxxx
# Enable long-polling (persistent connection) mode
FEISHU_STREAM_ENABLED=false

# Database path
DATABASE_PATH=./data/stock_analysis.db

# ===================================
# Backtest configuration (optional)
# ===================================
# Enable backtest (true/false)
BACKTEST_ENABLED=true
# Backtest evaluation window (trading days)
BACKTEST_EVAL_WINDOW_DAYS=10
# Only backtest analysis records older than N days (avoids incomplete data for recent records)
BACKTEST_MIN_AGE_DAYS=14
# Backtest engine version (used to distinguish results when backtest logic is upgraded)
BACKTEST_ENGINE_VERSION=v1
# Neutral band threshold (%); e.g., 2 means -2%~+2% is treated as sideways
BACKTEST_NEUTRAL_BAND_PCT=2.0

# === Scheduled task configuration ===
# Enable scheduled tasks (true/false)
SCHEDULE_ENABLED=false
# Daily execution time (HH:MM format, 24-hour clock)
SCHEDULE_TIME=18:00
# Whether to run one analysis immediately when starting in scheduled mode (true/false)
SCHEDULE_RUN_IMMEDIATELY=true
# Whether to run one analysis immediately when starting in non-scheduled mode (true/false)
RUN_IMMEDIATELY=true
# Enable market review (true/false)
MARKET_REVIEW_ENABLED=true
# Market review region: cn (A-shares), us (US stocks), both; use 'us' if you only track US stocks
# MARKET_REVIEW_REGION=cn

# ===================================
# Proxy configuration (optional)
# ===================================
# Enable proxy (true/false, default false)
# Only active in local development; automatically skipped in GitHub Actions
USE_PROXY=false
# Proxy server host (default 127.0.0.1)
PROXY_HOST=127.0.0.1
# Proxy server port (default 10809)
PROXY_PORT=10809

# System configuration
# Log directory
LOG_DIR=./logs
# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Maximum concurrent threads (keep low to avoid rate limiting)
MAX_WORKERS=3
# Enable debug logging
DEBUG=false

# ===================================
# WebUI configuration (optional)
# ===================================
# Enable WebUI on startup (true/false, default false)
WEBUI_ENABLED=false
# WebUI listen address (default 127.0.0.1; set to 0.0.0.0 for external access in Docker/cloud; see docs/deploy-webui-cloud.md)
WEBUI_HOST=127.0.0.1
# WebUI listen port (default 8000)
WEBUI_PORT=8000
# Auto-build frontend before starting Web service (npm install && npm run build, default true)
WEBUI_AUTO_BUILD=true
# Trust X-Forwarded-For for real client IP behind a single trusted reverse proxy (e.g., Nginx → App); the rightmost value is used for login rate-limiting. In multi-tier proxy/CDN setups the rate-limit key may degrade to the edge proxy IP — evaluate carefully. Keep false when directly exposed to the internet to prevent spoofing
# TRUST_X_FORWARDED_FOR=false

# ===================================
# Web login authentication (optional)
# ===================================
# Set to true to enable password protection; set the initial password on first visit; change it via 'System Settings > Change Password'
# To reset a forgotten password, run: python -m src.auth reset_password
ADMIN_AUTH_ENABLED=false
# ADMIN_SESSION_MAX_AGE_HOURS=24  # Session expiry (hours)

# ===========================================
# Stock code recognition from images (Settings page: 'Add from Image')
# ===========================================
# Single request timeout: 60 seconds; maximum image size: 5 MB
# Requires at least one of: GEMINI_API_KEY, ANTHROPIC_API_KEY, or OPENAI_API_KEY (Vision-capable model)

# ===========================================
# Data Fetcher Priority Configuration
# ===========================================
# Lower number = higher priority (tried first)
# Default priorities: efinance(0) > akshare(1) > tushare/pytdx(2) > baostock(3) > yfinance(4)
# For US stocks, set YFINANCE_PRIORITY=0 to use Yahoo Finance first

# EFINANCE_PRIORITY=0      # EastMoney (China) - default: 0
# EFINANCE_CALL_TIMEOUT=30 # Timeout (seconds) for efinance API calls; prevents indefinite hangs
#                          # when eastmoney hosts are unreachable. Default: 30
# AKSHARE_PRIORITY=1       # AkShare (China) - default: 1
# TUSHARE_PRIORITY=2       # Tushare Pro (China) - default: 2
# PYTDX_PRIORITY=2         # Tongdaxin (China) - default: 2
#
# Pytdx custom server (for intranet/deploy): use custom host instead of built-in public servers
# PYTDX_HOST=192.168.1.100
# PYTDX_PORT=7709
# Or multiple servers: PYTDX_SERVERS=ip1:port1,ip2:port2
# BAOSTOCK_PRIORITY=3      # Baostock (China) - default: 3
# YFINANCE_PRIORITY=4      # Yahoo Finance (Global) - default: 4

# Example: Prioritize Yahoo Finance for US stocks
# YFINANCE_PRIORITY=0
# EFINANCE_PRIORITY=99

# ===========================================
# Real-time quote data source priority configuration
# ===========================================
# Used to fetch real-time data such as volume ratio, turnover rate, and P/E ratio
# Available data sources (comma-separated, tried in order):
#   - tencent: Tencent Finance; has volume ratio/turnover/PE/PB; stable single-stock queries (recommended first choice)
#   - akshare_sina: Sina Finance; basic quotes; no volume ratio; very stable
#   - efinance: EastMoney (efinance library); has volume ratio; full-market pull risks IP ban
#   - akshare_em: EastMoney (akshare library); most complete data; full-market pull risks IP ban
#   - tushare: Tushare Pro; requires 2000 points; comprehensive data (recommended for paid users)
#
# Default priority: tencent > akshare_sina > efinance > akshare_em
# If you have a high-credit Tushare Pro account, put tushare first:
# REALTIME_SOURCE_PRIORITY=tushare,tencent,akshare_sina,efinance,akshare_em
# REALTIME_SOURCE_PRIORITY=tencent,akshare_sina,efinance,akshare_em

# Enable real-time quotes (when disabled, uses historical closing prices for analysis)
# ENABLE_REALTIME_QUOTE=true

# Intraday real-time technicals: when enabled, calculates MA/bull-alignment using the live price (Issue #234); when disabled, uses yesterday's close
# ENABLE_REALTIME_TECHNICAL_INDICATORS=true

# Enable chip distribution (this API is unstable; recommended to disable in cloud deployments)
# ENABLE_CHIP_DISTRIBUTION=true

# Enable fundamental aggregation pipeline (new P0 capability)
# ENABLE_FUNDAMENTAL_PIPELINE=true

# Fundamental aggregation performance and stability parameters (unit: seconds)
# FUNDAMENTAL_STAGE_TIMEOUT_SECONDS=1.5
# FUNDAMENTAL_FETCH_TIMEOUT_SECONDS=0.8
# FUNDAMENTAL_RETRY_MAX=1
# FUNDAMENTAL_CACHE_TTL_SECONDS=120
# FUNDAMENTAL_CACHE_MAX_ENTRIES=256

# ===========================================
# Portfolio P0: import / risk / FX rate degradation configuration
# ===========================================
# PORTFOLIO_RISK_CONCENTRATION_ALERT_PCT=35.0
# PORTFOLIO_RISK_DRAWDOWN_ALERT_PCT=15.0
# PORTFOLIO_RISK_STOP_LOSS_ALERT_PCT=10.0
# PORTFOLIO_RISK_STOP_LOSS_NEAR_RATIO=0.8
# PORTFOLIO_RISK_LOOKBACK_DAYS=180
# PORTFOLIO_FX_UPDATE_ENABLED=true

# EastMoney patch: recommended when EastMoney/Efinance/AkShare interfaces fail frequently (RemoteDisconnected / connection closed)
# When enabled, injects an NID token and random User-Agent to reduce the probability of being rate-limited by EastMoney
# ENABLE_EASTMONEY_PATCH=false
